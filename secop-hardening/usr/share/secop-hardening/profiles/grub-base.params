# --- ANSSI BP-028 R8, R11 : parametres de ligne de commande du noyau -------
# Un parametre par ligne. Les lignes vides et les commentaires sont ignores.

# R11 - Activation du LSM Yama au demarrage.
# Complete kernel.yama.ptrace_scope=1 depose par le module sysctl : le point
# R11 exige les deux.
lsm=landlock,lockdown,yama,integrity,apparmor

# R8 - Attenuations des vulnerabilites d'execution speculative.
l1tf=full,force
pti=on
spec_store_bypass_disable=seccomp
spectre_v2=on

# R8 - Durcissement de l'allocateur memoire.
# Cout en performance non negligeable : slub_debug active des verifications
# a chaque allocation, page_poison efface la memoire liberee.
page_poison=on
slab_nomerge=yes
slub_debug=FZP
page_alloc.shuffle=1

# R8 - Divers.
mce=0
rng_core.default_quality=500
