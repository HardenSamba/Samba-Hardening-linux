# Fichiers et repertoires sensibles - ANSSI BP-028 R6, R29, R50
# Format : chemin|mode|proprietaire|groupe
# Les chemins absents du systeme sont ignores silencieusement.

/etc/passwd|0644|root|root
/etc/group|0644|root|root
/etc/shadow|0600|root|root
/etc/gshadow|0600|root|root
/etc/sudoers|0440|root|root
/etc/sudoers.d|0750|root|root
/etc/ssh/sshd_config|0600|root|root
/etc/crontab|0600|root|root
/etc/cron.d|0700|root|root
/etc/cron.daily|0700|root|root
/etc/cron.hourly|0700|root|root
/etc/cron.monthly|0700|root|root
/etc/cron.weekly|0700|root|root
/boot|0700|root|root
/boot/grub/grub.cfg|0400|root|root
